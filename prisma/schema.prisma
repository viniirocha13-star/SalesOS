generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPERVISOR
  OPERADOR
  OPERATOR
  ANALISTA
  ANALYST
}

enum LeadStatus {
  NOVO
  EM_ATENDIMENTO_IA
  QUALIFICANDO
  CONSULTANDO_VIABILIDADE
  OFERTA_APRESENTADA
  NEGOCIANDO
  ACEITE_COMERCIAL
  COLETANDO_DADOS
  PRONTO_PARA_LANCAMENTO
  EM_LANCAMENTO
  PENDENCIA
  CADASTRO_APROVADO
  CONTRATO
  DOCUMENTACAO
  AGUARDANDO_INSTALACAO
  INSTALADO
  PERDIDO
}

enum LeadSource {
  META
  GOOGLE
  INSTAGRAM
  FACEBOOK
  QR_CODE
  LINK
  ORGANICO
  INDICACAO
  OUTROS
}

enum OfferStatus {
  DETECTADA
  AGUARDANDO_APROVACAO
  APROVADA
  REJEITADA
  EXPIRADA
}

enum BookStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  APPROVED
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum AcquisitionType {
  NEW_CUSTOMER
  RETENTION
  MIGRATION
  OTHER
}

enum KnowledgeType {
  OFERTAS
  FAQ
  REGRAS_COMERCIAIS
  PROCEDIMENTOS
  OBJECOES
  DOCUMENTOS
  POLITICAS
}

enum ViabilityResult {
  VIAVEL
  NAO_VIAVEL
  INDETERMINADO
}

enum PreSaleStatus {
  RASCUNHO
  PRONTA
  EM_LANCAMENTO
  APROVADA
  PENDENCIA
  REPROVADA
}

enum LaunchResult {
  APROVADO
  PENDENCIA
  REPROVADO
}

enum ObjectionCategory {
  PRECO
  VAI_PENSAR
  CONCORRENTE
  FIDELIDADE
  INSTALACAO
  CONVERSAR_COM_FAMILIA
  SEM_INTERESSE
  JA_POSSUI_INTERNET
  PORTABILIDADE
  OUTROS
}

enum ConversationChannel {
  WHATSAPP
  SIMULATOR
}

enum ConversationStatus {
  IA_ATIVA
  HANDOFF_HUMANO
  ENCERRADA
}

enum HandoffReason {
  CLIENTE_SOLICITOU
  IA_SEM_CONFIANCA
  INFORMACAO_NAO_ENCONTRADA
  RECLAMACAO
  CASO_SENSIVEL
  FALHA_VIABILIDADE
  EXCECAO_COMERCIAL
  FALHA_REPETIDA_IA
}

enum HandoffStatus {
  ABERTO
  EM_ATENDIMENTO
  DEVOLVIDO_IA
  ENCERRADO
}

enum DomainEventType {
  LEAD_CREATED
  MESSAGE_RECEIVED
  MESSAGE_BUFFER_READY
  AI_RESPONSE_REQUESTED
  VIABILITY_CHECKED
  OFFER_PRESENTED
  OBJECTION_DETECTED
  BUYING_INTENT_DETECTED
  CUSTOMER_ACCEPTED
  COMMERCIAL_ACCEPTED
  PRE_SALE_CREATED
  PRE_SALE_READY
  OPERATOR_ASSIGNED
  SALE_REGISTERED
  SALE_PENDING
  SALE_REJECTED
  CONTRACT_PENDING
  SALE_INSTALLED
  HUMAN_HANDOFF_STARTED
  HUMAN_HANDOFF_ENDED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageActor {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

enum SalesStage {
  NEW
  GREETING
  DISCOVERY
  LOCATION_COLLECTION
  VIABILITY_CHECK
  NEEDS_ANALYSIS
  OFFER_SELECTION
  OFFER_PRESENTATION
  NEGOTIATION
  OBJECTION_HANDLING
  BUYING_INTENT
  COMMERCIAL_ACCEPTANCE
  DATA_COLLECTION
  PRE_SALE_READY
  WAITING_OPERATOR
  OPERATOR_PROCESSING
  OPERATOR_PENDING
  REGISTERED
  CONTRACT_PENDING
  DOCUMENT_PENDING
  INSTALLATION_PENDING
  INSTALLED
  LOST
  HUMAN_HANDOFF
}

enum IntentType {
  BUY
  QUESTION
  OBJECTION
  NEGOTIATION
  CANCEL
  HUMAN_REQUEST
  SEND_DOCUMENT
  ADDRESS
  PERSONAL_DATA
  COMPLAINT
  OTHER
}

enum IntegrationStatus {
  CONNECTED
  ERROR
  NOT_CONFIGURED
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Tenant {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  createdAt     DateTime       @default(now())
  users         User[]
  leads         Lead[]
  conversations Conversation[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                  Tenant?              @relation(fields: [tenantId], references: [id])
  assignedLeads           Lead[]               @relation("LeadOwner")
  assignedPreSales        PreSale[]            @relation("PreSaleOwner")
  auditLogs               AuditLog[]
  humanHandoffs           HumanHandoff[]
  assignedConversations   Conversation[]       @relation("ConversationOwner")
  memberships             OrganizationMember[]
  waAssignedConversations WaConversation[]     @relation("WaConversationAssignee")
}

model Lead {
  id              String     @id @default(cuid())
  tenantId        String?
  name            String?
  phone           String
  city            String?
  neighborhood    String?
  address         String?
  zipCode         String?
  latitude        Float?
  longitude       Float?
  origin          LeadSource @default(OUTROS)
  source          String?
  campaignId      String?
  adset           String?
  ad              String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  clickId         String?
  landingPage     String?
  productInterest String?
  status          LeadStatus @default(NOVO)
  score           Int        @default(0)
  ownerId         String?
  customerId      String?
  lostReason      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant          Tenant?                @relation(fields: [tenantId], references: [id])
  campaign        Campaign?              @relation(fields: [campaignId], references: [id])
  owner           User?                  @relation("LeadOwner", fields: [ownerId], references: [id])
  customer        Customer?              @relation(fields: [customerId], references: [id])
  statusHistory   LeadStatusHistory[]
  conversations   Conversation[]
  viabilityChecks ViabilityCheck[]
  objections      Objection[]
  preSales        PreSale[]
  consents        Consent[]
  aiExecutions    AIExecution[]
  facts           CustomerFact[]
  acceptances     CommercialAcceptance[]

  @@index([phone])
  @@index([status])
  @@index([campaignId])
  @@index([city])
  @@index([tenantId])
}

model LeadStatusHistory {
  id         String      @id @default(cuid())
  leadId     String
  fromStatus LeadStatus?
  toStatus   LeadStatus
  reason     String?
  actorId    String?
  createdAt  DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Customer {
  id                   String    @id @default(cuid())
  fullName             String?
  documentCpf          String?
  documentCpfEncrypted String?
  email                String?
  phone                String    @unique
  birthDate            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  leads    Lead[]
  preSales PreSale[]
}

model Campaign {
  id         String     @id @default(cuid())
  name       String
  channel    LeadSource
  externalId String?
  spendCents Int        @default(0)
  active     Boolean    @default(true)
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  leads Lead[]
}

model OfferBook {
  id            String     @id @default(cuid())
  originalName  String
  mimeType      String
  storagePath   String
  extractedText String?    @db.Text
  month         String?
  importedById  String?
  status        BookStatus @default(ACTIVE)
  lineCount     Int        @default(0)
  offerCount    Int        @default(0)
  errorCount    Int        @default(0)
  warningCount  Int        @default(0)
  stats         Json?
  activatedAt   DateTime?
  createdAt     DateTime   @default(now())

  offers    Offer[]
  knowledge ProductKnowledge[]
}

model Offer {
  id                       String           @id @default(cuid())
  name                     String
  category                 String?
  product                  String?
  speedMbps                Int?
  priceCents               Int?
  promotionalPriceCents    Int?
  futurePriceCents         Int?
  promotionalPeriod        String?
  benefits                 String[]
  loyalty                  String?
  installation             String?
  city                     String?
  region                   String?
  eligibility              String?
  rules                    String?          @db.Text
  restrictions             String?          @db.Text
  startsAt                 DateTime?
  endsAt                   DateTime?
  source                   String?
  bookId                   String?
  originalText             String?          @db.Text
  status                   OfferStatus      @default(DETECTADA)
  reviewNotes              String?
  acquisitionType          AcquisitionType?
  salesChannelRaw          String?
  channelAllows            String[]         @default([])
  channelExcludes          String[]         @default([])
  categoryNormalized       String?
  offerLevel               String?
  pricingPeriodDescription String?
  pricingOriginalText      String?
  promotionDurationMonths  Int?
  includedProducts         String[]         @default([])
  unlimitedApps            String[]         @default([])
  launchCodes              String?          @db.Text
  includedStreaming        Json?
  featuresOriginalText     String?
  installationIncluded     Boolean?
  wifiIncluded             Boolean?
  unlimitedCalls           Boolean?
  unlimitedSms             Boolean?
  roamingGb                Float?
  deviceLoan               Boolean?
  isCombo                  Boolean          @default(false)
  mobileDataGb             Int?
  fwaAllowanceGb           Int?
  fingerprint              String?
  sourceRow                Int?
  sourceSheet              String?
  sourceFile               String?
  validationErrors         Json?
  validationWarnings       Json?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  book     OfferBook? @relation(fields: [bookId], references: [id])
  preSales PreSale[]

  @@index([status])
  @@index([city])
  @@index([fingerprint])
  @@index([categoryNormalized])
}

model ProductKnowledge {
  id         String   @id @default(cuid())
  bookId     String
  category   String?
  title      String
  queryTerms String[]
  facts      Json
  content    String   @db.Text
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  book OfferBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model KnowledgeDocument {
  id          String        @id @default(cuid())
  title       String
  type        KnowledgeType
  content     String        @db.Text
  version     Int           @default(1)
  active      Boolean       @default(true)
  approved    Boolean       @default(false)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions KnowledgeVersion[]
}

model KnowledgeVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  content    String   @db.Text
  createdAt  DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id               String              @id @default(cuid())
  tenantId         String?
  leadId           String
  channel          ConversationChannel @default(SIMULATOR)
  waConversationId String?
  status           ConversationStatus  @default(IA_ATIVA)
  salesStage       SalesStage          @default(NEW)
  aiEnabled        Boolean             @default(true)
  lockOwnerId      String?
  lockUntil        DateTime?
  unreadCount      Int                 @default(0)
  lastInboundAt    DateTime?
  ownerId          String?
  lastMessageAt    DateTime?
  version          Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant       Tenant?             @relation(fields: [tenantId], references: [id])
  lead         Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner        User?               @relation("ConversationOwner", fields: [ownerId], references: [id])
  messages     Message[]
  handoffs     HumanHandoff[]
  aiExecutions AIExecution[]
  memory       ConversationMemory?
  stageHistory SalesStageHistory[]

  @@index([leadId])
  @@index([tenantId, lastMessageAt])
  @@index([status, aiEnabled])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  actor             MessageActor     @default(CUSTOMER)
  body              String           @db.Text
  mediaUrl          String?
  mediaType         String?
  templateName      String?
  waMessageId       String?          @unique
  providerMessageId String?
  wamid             String?
  status            MessageStatus    @default(RECEIVED)
  idempotencyKey    String?          @unique
  buffered          Boolean          @default(false)
  metadata          Json?
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ViabilityCheck {
  id           String          @id @default(cuid())
  leadId       String
  address      String?
  zipCode      String?
  city         String?
  neighborhood String?
  latitude     Float?
  longitude    Float?
  result       ViabilityResult
  source       String
  details      Json?
  createdAt    DateTime        @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Objection {
  id        String            @id @default(cuid())
  leadId    String
  category  ObjectionCategory
  text      String            @db.Text
  response  String?           @db.Text
  result    String?
  createdAt DateTime          @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ObjectionPlaybook {
  id        String            @id @default(cuid())
  category  ObjectionCategory
  argument  String            @db.Text
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model PreSale {
  id               String        @id @default(cuid())
  leadId           String
  offerId          String
  customerId       String?
  registrationData Json?
  address          String?
  viabilitySummary String?
  consentsSnapshot Json?
  aiSummary        String?       @db.Text
  status           PreSaleStatus @default(PRONTA)
  ownerId          String?
  quoteNumber      String?
  orderNumber      String?
  launchResult     LaunchResult?
  launchNotes      String?
  queuedAt         DateTime      @default(now())
  claimedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offer    Offer     @relation(fields: [offerId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  owner    User?     @relation("PreSaleOwner", fields: [ownerId], references: [id])
  sale     Sale?

  @@index([status])
}

model Sale {
  id          String    @id @default(cuid())
  preSaleId   String    @unique
  leadId      String
  campaignId  String?
  offerId     String
  ticketCents Int?
  installedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  preSale PreSale     @relation(fields: [preSaleId], references: [id])
  events  SaleEvent[]
}

model SaleEvent {
  id        String          @id @default(cuid())
  saleId    String
  type      DomainEventType
  payload   Json?
  createdAt DateTime        @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model DomainEvent {
  id          String          @id @default(cuid())
  type        DomainEventType
  aggregateId String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([type])
}

model HumanHandoff {
  id             String        @id @default(cuid())
  conversationId String
  reason         HandoffReason
  notes          String?
  status         HandoffStatus @default(ABERTO)
  assignedToId   String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation(fields: [assignedToId], references: [id])
}

model Consent {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  granted   Boolean
  text      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model AIExecution {
  id               String   @id @default(cuid())
  conversationId   String?
  leadId           String?
  model            String
  intent           String?
  toolName         String?
  offerId          String?
  knowledgeSource  String?
  confidence       Float?
  inputTokens      Int?
  outputTokens     Int?
  cachedTokens     Int?
  estimatedCostUsd Float?
  purpose          String?
  result           String?  @db.Text
  createdAt        DateTime @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])

  @@index([conversationId])
  @@index([leadId])
}

model RetentionPolicy {
  id        String   @id @default(cuid())
  entity    String   @unique
  days      Int
  updatedAt DateTime @updatedAt
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  direction String
  payload   Json
  createdAt DateTime @default(now())
}

model ConversationMemory {
  id                      String   @id @default(cuid())
  conversationId          String   @unique
  summary                 String?  @db.Text
  customerFacts           Json?
  commercialState         Json?
  objections              Json?
  offersPresented         Json?
  acceptedOfferId         String?
  pendingQuestions        Json?
  importantEvents         Json?
  lastSummarizedMessageId String?
  updatedAt               DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model SalesStageHistory {
  id             String      @id @default(cuid())
  conversationId String
  fromStage      SalesStage?
  toStage        SalesStage
  reason         String?
  actor          String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CustomerFact {
  id        String   @id @default(cuid())
  leadId    String
  key       String
  value     String
  source    String   @default("conversation")
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, key])
}

model CommercialAcceptance {
  id            String   @id @default(cuid())
  leadId        String
  offerId       String
  messageId     String?
  offerSnapshot Json?
  createdAt     DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model WhatsAppInboundEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
}

model Prompt {
  id       String          @id @default(cuid())
  slug     String          @unique
  name     String
  versions PromptVersion[]
}

model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String
  version   Int
  content   String   @db.Text
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
}

model WhatsAppTemplate {
  id                 String  @id @default(cuid())
  providerTemplateId String?
  name               String
  language           String  @default("pt_BR")
  category           String?
  status             String  @default("DRAFT")
  variables          Json?
  purpose            String?
}

model RequiredFieldDefinition {
  id          String  @id @default(cuid())
  productType String
  fieldKey    String
  label       String
  required    Boolean @default(true)
  pattern     String?
}

model Integration {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  status    IntegrationStatus @default(NOT_CONFIGURED)
  lastError String?
  testedAt  DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FollowUp {
  id             String    @id @default(cuid())
  conversationId String
  stage          String
  delayMinutes   Int
  attempts       Int       @default(0)
  maxAttempts    Int       @default(2)
  templateName   String?
  dueAt          DateTime
  sentAt         DateTime?
  cancelled      Boolean   @default(false)
}

model Workflow {
  id    String         @id @default(cuid())
  name  String
  steps WorkflowStep[]
}

model WorkflowStep {
  id         String  @id @default(cuid())
  workflowId String
  name       String
  type       String
  order      Int
  required   Boolean @default(true)
  template   String?
  condition  Json?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model ModelPrice {
  id            String   @id @default(cuid())
  model         String   @unique
  inputPerMTok  Float
  outputPerMTok Float
  updatedAt     DateTime @updatedAt
}

model OfferPresentation {
  id             String   @id @default(cuid())
  conversationId String
  offerId        String
  snapshot       Json
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model CommercialDecision {
  id               String   @id @default(cuid())
  conversationId   String
  intent           String?
  buyingIntent     String?
  objection        String?
  strategyLabel    String?
  selectedOfferId  String?
  toolCalls        Json?
  confidence       Float?
  escalationReason String?
  model            String
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  createdAt        DateTime @default(now())

  @@index([conversationId, createdAt])
}

model ComplexityEscalation {
  id             String   @id @default(cuid())
  conversationId String
  fromModel      String
  toModel        String
  reason         String
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model WorkflowExecution {
  id             String   @id @default(cuid())
  workflowId     String
  conversationId String?
  leadId         String?
  status         String   @default("ACTIVE")
  currentOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// WhatsApp Business Platform SaaS (multi-tenant). Tabelas em snake_case.
// ---------------------------------------------------------------------------

enum OrgRole {
  OWNER
  ADMIN
  OPERATOR
  ANALYST
  SUPPORT
}

enum MetaConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  ACTION_REQUIRED
  TOKEN_EXPIRED
  ERROR
}

enum MetaTokenSource {
  EMBEDDED_SIGNUP
  MANUAL
}

enum PhoneNumberStatus {
  DISCOVERED
  REGISTRATION_REQUIRED
  VERIFICATION_PENDING
  CONNECTING
  CONNECTED
  ERROR
}

enum ContactStatus {
  ACTIVE
  OPTED_OUT
  BLOCKED
  INVALID
}

enum ConsentType {
  MARKETING
  TRANSACTIONAL
  ALL
}

enum ConsentSource {
  LANDING_PAGE
  FORM
  CHECKOUT
  CRM
  EVENT
  SUPPORT
  AUTHORIZED_IMPORT
  API
  INBOUND_MESSAGE
}

enum ContactListKind {
  STATIC
  DYNAMIC
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum WaCampaignStatus {
  DRAFT
  SCHEDULED
  QUEUING
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum WaMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum WaConversationStatus {
  OPEN
  CLOSED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AutomationTrigger {
  CONTACT_REPLIED
  MESSAGE_FAILED
  CONTACT_OPTED_OUT
  CAMPAIGN_FINISHED
  CONTACT_CREATED
}

enum AutomationAction {
  ADD_TAG
  ADD_TO_LIST
  NOTIFY
  WEBHOOK
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Organization {
  id                         String   @id @default(cuid())
  name                       String
  slug                       String   @unique
  legalName                  String?
  tradeName                  String?
  taxId                      String?
  address                    String?
  phone                      String?
  email                      String?
  website                    String?
  description                String?  @db.Text
  country                    String   @default("BR")
  timezone                   String   @default("America/Fortaleza")
  defaultLanguage            String   @default("pt_BR")
  requireConsentForCampaigns Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  members        OrganizationMember[]
  metaConnection MetaConnection?
  wabas          WhatsAppBusinessAccount[]
  phoneNumbers   PhoneNumber[]
  contacts       Contact[]
  consents       ContactConsent[]
  lists          ContactList[]
  listMembers    ContactListMember[]
  tags           Tag[]
  contactTags    ContactTag[]
  imports        ContactImport[]
  templates      MessageTemplate[]
  campaigns      WaCampaign[]
  recipients     WaCampaignRecipient[]
  messages       WaMessage[]
  conversations  WaConversation[]
  webhookEvents  WebhookEvent[]
  pricingRates   PricingRate[]
  messageCosts   MessageCost[]
  subscription   Subscription?
  usageRecords   UsageRecord[]
  automations    Automation[]
  automationRuns AutomationRun[]
  alerts         SystemAlert[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(OPERATOR)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model MetaConnection {
  id                   String               @id @default(cuid())
  organizationId       String               @unique
  status               MetaConnectionStatus @default(NOT_CONNECTED)
  tokenSource          MetaTokenSource?
  businessId           String?
  businessName         String?
  appId                String?
  encryptedAccessToken String?              @db.Text
  tokenExpiresAt       DateTime?
  scopes               String[]             @default([])
  lastSyncedAt         DateTime?
  lastValidatedAt      DateTime?
  lastError            String?
  connectedById        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wabas        WhatsAppBusinessAccount[]

  @@map("meta_connections")
}

model WhatsAppBusinessAccount {
  id                       String    @id @default(cuid())
  organizationId           String
  metaConnectionId         String
  wabaId                   String
  name                     String?
  currency                 String?
  timezoneId               String?
  messageTemplateNamespace String?
  accountReviewStatus      String?
  subscribedApp            Boolean   @default(false)
  lastSyncedAt             DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metaConnection MetaConnection    @relation(fields: [metaConnectionId], references: [id], onDelete: Cascade)
  phoneNumbers   PhoneNumber[]
  templates      MessageTemplate[]

  @@unique([organizationId, wabaId])
  @@map("whatsapp_business_accounts")
}

model PhoneNumber {
  id                     String            @id @default(cuid())
  organizationId         String
  wabaId                 String
  phoneNumberId          String
  displayPhoneNumber     String
  verifiedName           String?
  status                 PhoneNumberStatus @default(DISCOVERED)
  qualityRating          String?
  messagingLimitTier     String?
  nameStatus             String?
  codeVerificationStatus String?
  platformType           String?
  isDefault              Boolean           @default(false)
  lastSyncedAt           DateTime?
  lastError              String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waba          WhatsAppBusinessAccount @relation(fields: [wabaId], references: [id], onDelete: Cascade)
  campaigns     WaCampaign[]
  messages      WaMessage[]
  conversations WaConversation[]

  @@unique([organizationId, phoneNumberId])
  @@index([phoneNumberId])
  @@map("phone_numbers")
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  name           String?
  phoneE164      String
  email          String?
  status         ContactStatus @default(ACTIVE)
  source         String?
  country        String?
  language       String?
  city           String?
  state          String?
  customFields   Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastMessageAt  DateTime?
  optedInAt      DateTime?
  optedOutAt     DateTime?
  blockedAt      DateTime?

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consents      ContactConsent[]
  listMembers   ContactListMember[]
  tags          ContactTag[]
  recipients    WaCampaignRecipient[]
  messages      WaMessage[]
  conversations WaConversation[]

  @@unique([organizationId, phoneE164])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, lastMessageAt])
  @@map("contacts")
}

model ContactConsent {
  id             String        @id @default(cuid())
  organizationId String
  contactId      String
  channel        String        @default("whatsapp")
  consentType    ConsentType   @default(MARKETING)
  source         ConsentSource
  proof          String?       @db.Text
  ipAddress      String?
  userAgent      String?
  grantedAt      DateTime      @default(now())
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([organizationId, grantedAt])
  @@map("contact_consents")
}

model ContactList {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?
  kind           ContactListKind @default(STATIC)
  filter         Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ContactListMember[]
  campaigns    WaCampaign[]

  @@index([organizationId])
  @@map("contact_lists")
}

model ContactListMember {
  id             String   @id @default(cuid())
  organizationId String
  listId         String
  contactId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  list         ContactList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([contactId])
  @@map("contact_list_members")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ContactTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model ContactTag {
  organizationId String
  contactId      String
  tagId          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

model ContactImport {
  id               String        @id @default(cuid())
  organizationId   String
  fileName         String
  totalRows        Int           @default(0)
  validRows        Int           @default(0)
  invalidRows      Int           @default(0)
  duplicateRows    Int           @default(0)
  createdRows      Int           @default(0)
  updatedRows      Int           @default(0)
  consentSource    ConsentSource @default(AUTHORIZED_IMPORT)
  consentConfirmed Boolean       @default(false)
  listId           String?
  createdById      String?
  createdAt        DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("contact_imports")
}

model MessageTemplate {
  id                String            @id @default(cuid())
  organizationId    String
  wabaId            String
  metaTemplateId    String?
  name              String
  language          String            @default("pt_BR")
  category          TemplateCategory  @default(UTILITY)
  requestedCategory TemplateCategory?
  previousCategory  TemplateCategory?
  status            TemplateStatus    @default(DRAFT)
  quality           String?
  rejectedReason    String?           @db.Text
  headerType        String?
  headerText        String?
  body              String            @db.Text
  footer            String?
  buttons           Json?
  variables         Json?
  exampleValues     Json?
  components        Json?
  lastSyncedAt      DateTime?
  lastReviewedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waba         WhatsAppBusinessAccount @relation(fields: [wabaId], references: [id], onDelete: Cascade)
  campaigns    WaCampaign[]

  @@unique([wabaId, name, language])
  @@index([organizationId, status])
  @@map("templates")
}

model WaCampaign {
  id                String           @id @default(cuid())
  organizationId    String
  name              String
  status            WaCampaignStatus @default(DRAFT)
  phoneNumberId     String
  templateId        String
  contactListId     String?
  variableMapping   Json?
  scheduledAt       DateTime?
  startedAt         DateTime?
  pausedAt          DateTime?
  finishedAt        DateTime?
  cancelledAt       DateTime?
  totalContacts     Int              @default(0)
  queuedCount       Int              @default(0)
  sentCount         Int              @default(0)
  deliveredCount    Int              @default(0)
  readCount         Int              @default(0)
  failedCount       Int              @default(0)
  repliedCount      Int              @default(0)
  skippedCount      Int              @default(0)
  estimatedCost     Decimal?         @db.Decimal(12, 4)
  estimatedCurrency String?
  lastError         String?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber  PhoneNumber           @relation(fields: [phoneNumberId], references: [id])
  template     MessageTemplate       @relation(fields: [templateId], references: [id])
  contactList  ContactList?          @relation(fields: [contactListId], references: [id])
  recipients   WaCampaignRecipient[]
  messages     WaMessage[]

  @@index([organizationId, status])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

model WaCampaignRecipient {
  id                String          @id @default(cuid())
  organizationId    String
  campaignId        String
  contactId         String
  status            RecipientStatus @default(PENDING)
  variables         Json?
  attempts          Int             @default(0)
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  repliedAt         DateTime?
  failureCode       String?
  failureMessage    String?
  skipReason        String?
  providerMessageId String?
  messageId         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     WaCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([providerMessageId])
  @@index([contactId, sentAt])
  @@map("campaign_recipients")
}

model WaMessage {
  id                String            @id @default(cuid())
  organizationId    String
  contactId         String
  conversationId    String?
  campaignId        String?
  phoneNumberId     String
  direction         MessageDirection
  type              String            @default("text")
  category          TemplateCategory?
  providerMessageId String?           @unique
  status            WaMessageStatus   @default(QUEUED)
  body              String?           @db.Text
  templateName      String?
  payload           Json?
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime          @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation WaConversation? @relation(fields: [conversationId], references: [id])
  campaign     WaCampaign?     @relation(fields: [campaignId], references: [id])
  phoneNumber  PhoneNumber     @relation(fields: [phoneNumberId], references: [id])
  cost         MessageCost?

  @@index([organizationId, createdAt])
  @@index([conversationId, createdAt])
  @@index([campaignId, status])
  @@map("messages")
}

model WaConversation {
  id                     String               @id @default(cuid())
  organizationId         String
  contactId              String
  phoneNumberId          String
  status                 WaConversationStatus @default(OPEN)
  serviceWindowExpiresAt DateTime?
  lastInboundAt          DateTime?
  lastOutboundAt         DateTime?
  lastMessagePreview     String?
  unreadCount            Int                  @default(0)
  assigneeId             String?
  internalNotes          String?              @db.Text
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber  PhoneNumber  @relation(fields: [phoneNumberId], references: [id])
  assignee     User?        @relation("WaConversationAssignee", fields: [assigneeId], references: [id])
  messages     WaMessage[]

  @@unique([contactId, phoneNumberId])
  @@index([organizationId, updatedAt])
  @@map("conversations")
}

model WebhookEvent {
  id              String             @id @default(cuid())
  provider        String             @default("meta")
  providerEventId String
  organizationId  String?
  phoneNumberId   String?
  wabaId          String?
  eventType       String
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  error           String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
  @@map("webhook_events")
}

model PricingRate {
  id             String           @id @default(cuid())
  organizationId String?
  market         String
  category       TemplateCategory
  currency       String           @default("BRL")
  rate           Decimal          @db.Decimal(12, 6)
  volumeTierMin  Int              @default(0)
  effectiveFrom  DateTime         @default(now())
  effectiveTo    DateTime?
  source         String           @default("manual")
  createdAt      DateTime         @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([market, category, effectiveFrom])
  @@map("pricing_rates")
}

model MessageCost {
  id               String            @id @default(cuid())
  organizationId   String
  messageId        String            @unique
  category         TemplateCategory?
  billableCategory String?
  pricingModel     String?
  billable         Boolean?
  market           String?
  currency         String?
  estimatedCost    Decimal?          @db.Decimal(12, 6)
  actualCost       Decimal?          @db.Decimal(12, 6)
  source           String            @default("estimate")
  createdAt        DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      WaMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("message_costs")
}

model Plan {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  priceCents          Int      @default(0)
  currency            String   @default("BRL")
  maxUsers            Int      @default(3)
  maxContacts         Int      @default(1000)
  maxMessagesPerMonth Int      @default(5000)
  maxPhoneNumbers     Int      @default(1)
  maxAutomations      Int      @default(3)
  logRetentionDays    Int      @default(30)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  provider           String?
  externalId         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  metric         String
  quantity       Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
  @@map("usage_records")
}

model Automation {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  enabled        Boolean           @default(true)
  trigger        AutomationTrigger
  conditions     Json?
  action         AutomationAction
  actionConfig   Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId, trigger, enabled])
  @@map("automations")
}

model AutomationRun {
  id             String   @id @default(cuid())
  organizationId String
  automationId   String
  status         String   @default("OK")
  context        Json?
  error          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, createdAt])
  @@map("automation_runs")
}

model SystemAlert {
  id             String        @id @default(cuid())
  organizationId String?
  severity       AlertSeverity @default(WARNING)
  kind           String
  title          String
  detail         String?       @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resolvedAt, createdAt])
  @@map("system_alerts")
}
