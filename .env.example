# Database
DATABASE_URL="postgresql://brisa:brisa_dev_local@localhost:5432/brisa_sales?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:43147"

# Optional: OpenAI for extração de book e SalesAgent real
# Sem esta chave, o sistema usa DevMockLlmProvider (identificado no UI)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Criptografia de campos sensíveis em repouso
APP_ENCRYPTION_KEY="replace-with-32-byte-hex-or-passphrase"

# WhatsApp Cloud API (Fase 2) — deixe vazio para DevMockWhatsAppProvider
WHATSAPP_PROVIDER="mock"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="replace-verify-token"
WHATSAPP_APP_SECRET=""

# Viabilidade
VIABILITY_PROVIDER="internal"

# Retenção padrão (dias)
DATA_RETENTION_DAYS="365"

# App
NEXT_PUBLIC_APP_NAME="Brisa Sales AI"
