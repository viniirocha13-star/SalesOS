# Database
DATABASE_URL="postgresql://brisa:brisa_dev_local@localhost:5432/brisa_sales?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# WEB (Railway injeta PORT; APP_PORT é o fallback local)
PORT=
APP_PORT=43147
APP_HOST=0.0.0.0
APP_URL="http://127.0.0.1:43147"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://127.0.0.1:43147"
# Nunca ligue no processo web em produção. Worker: npm run worker
START_WORKER_IN_NEXT=""
ENCRYPTION_KEY="replace-with-32-byte-hex-or-passphrase"

# OpenAI — mesma chave para Terra, Sol e Luna
OPENAI_API_KEY=""
OPENAI_API_STYLE="responses" # responses | chat
CONVERSATION_SUMMARY_AFTER="24"
AI_SALES_MODEL="gpt-5.6-terra"
AI_COMPLEX_MODEL="gpt-5.6-sol"
AI_UTILITY_MODEL="gpt-5.6-luna"
AI_COMPLEX_ENABLED="true"
MAX_SOL_CALLS_PER_CONVERSATION="2"
AI_SALES_REASONING_EFFORT="low"
OPENAI_MODEL="gpt-5.6-terra"

# WhatsApp Cloud API
WHATSAPP_PROVIDER="mock"
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="replace-verify-token"
META_ACCESS_TOKEN=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="replace-verify-token"
WHATSAPP_SESSION_WINDOW_HOURS="24"
MESSAGE_BUFFER_MS="3500"
FOLLOWUP_DELAY_MINUTES="60"

# Viabilidade — API oficial (quando houver contrato). Sem isso: geocode + fila do operador.
BRISANET_VIABILITY_URL=""
BRISANET_VIABILITY_TOKEN=""
BRISANET_VIABILITY_METHOD="POST"
GEOCODE_PROVIDER="nominatim"
GOOGLE_GEOCODE_API_KEY=""

# Object storage
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Ads (marco 2)
GOOGLE_ADS_CUSTOMER_ID=""

DATA_RETENTION_DAYS="365"
NEXT_PUBLIC_APP_NAME="Sales OS"
